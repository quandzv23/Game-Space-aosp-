<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sidebar_panel_bg"
    android:padding="18dp">

    <TextView
        android:id="@+id/picker_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chọn app"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/picker_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/panel_row_bg"
        android:hint="Tìm app..."
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:padding="12dp"
        android:textSize="13sp"
        android:inputType="text"
        android:maxLines="1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/picker_list"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="12dp" />

</LinearLayout>
