<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="272dp"
    android:layout_height="wrap_content"
    android:maxHeight="560dp"
    android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sidebar_panel_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="QSPACE"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/header_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/header_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--%"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/btn_close_panel"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:text="✕"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Chip CPU% / FPS thời gian thực -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/panel_row_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU "
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cpu_usage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="@color/accent_amber"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/panel_row_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS "
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/panel_fps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Thanh trạng thái CPU% + FPS trực tiếp trong panel, giống GameTurbo thật -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/panel_row_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU "
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cpu_usage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--%"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/panel_row_bg"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS "
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/panel_fps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Chế độ hiệu năng: 3 ô vuông ngang hàng, kiểu HyperOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_balanced"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/tile_bg_active"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚖️"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cân bằng"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/check_balanced"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/accent_amber"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_perf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hiệu năng"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/check_perf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/accent_amber"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tiết kiệm"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/check_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/accent_amber"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/feedback_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text=""
        android:textSize="11sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="TIỆN ÍCH"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.15" />

    <!-- Lưới tiện ích 4 ô/hàng, gọn hơn — khớp bản HyperOS mới nhất (4x4 grid) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/row_dnd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="7dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔕" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Chặn TB"
                android:textColor="@color/text_primary" android:textSize="8sp" />
            <TextView android:id="@+id/dnd_state" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tắt"
                android:textColor="@color/text_secondary" android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_fps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="7dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📊" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="FPS"
                android:textColor="@color/text_primary" android:textSize="8sp" />
            <TextView android:id="@+id/fps_state" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tắt"
                android:textColor="@color/text_secondary" android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_touchlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="7dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔒" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Khóa góc"
                android:textColor="@color/text_primary" android:textSize="8sp" />
            <TextView android:id="@+id/touchlock_state" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tắt"
                android:textColor="@color/text_secondary" android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_callblock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="7dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📵" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Chặn gọi"
                android:textColor="@color/text_primary" android:textSize="8sp" />
            <TextView android:id="@+id/callblock_state" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tắt"
                android:textColor="@color/text_secondary" android:textSize="7sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/row_wifi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="7dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📶" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="WiFi"
                android:textColor="@color/text_primary" android:textSize="8sp" />
            <TextView android:id="@+id/wifi_state" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tắt"
                android:textColor="@color/text_secondary" android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_multitask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/tile_bg_inactive"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="7dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📱" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Đa nhiệm"
                android:textColor="@color/text_primary" android:textSize="8sp" />
            <TextView android:id="@+id/multitask_state" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Tắt"
                android:textColor="@color/text_secondary" android:textSize="7sp" />
        </LinearLayout>

        <!-- 2 ô trống dành cho tiện ích sau này, giữ đúng khung 4x4 -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:paddingVertical="7dp" />
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingVertical="7dp" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/quick_apps_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quick_apps_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

</LinearLayout>
</ScrollView>
